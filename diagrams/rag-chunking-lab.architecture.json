  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Browser → Next.js :3001 → FastAPI :8010",
        "Indexing and eval return a job id; the UI polls /api/jobs/{id}",
        "The API holds no retrieval logic — it calls the modules the CLI does"
      ]
    },
    {
      "dot": "emerald",
      "title": "Indexing pipeline",
      "items": [
        "pdfplumber extraction keeps character offsets per page",
        "Fixed 500/50 · structural 400-token · semantic window=3, θ=0.85",
        "All three chunk sets land in one document_chunks table"
      ]
    },
    {
      "dot": "violet",
      "title": "Retrieval and scoring",
      "items": [
        "One query embedding, three strategy-filtered searches",
        "pgvector HNSW, cosine distance, top-3 per strategy",
        "Hit-Rate@3 scored against answer spans, not chunk ids"
      ]
    }
  ]
