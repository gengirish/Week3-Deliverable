# Supabase credentials
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Actual Postgres database password (Settings > Database > Reset database password).
# NOT the service_role key above -- that's a JWT used only for the REST/Auth APIs.
SUPABASE_DB_PASSWORD=your-database-password

# Optional: override the Supavisor pooler host if your project isn't in ap-south-1
# (find yours in Settings > Database > Connection pooling).
# SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com

# OpenAI API key
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Path to the PDF file to ingest
PDF_PATH=./data/document.pdf
