# Supabase project URL — Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Service-role key — Settings > API. Used for the REST client only.
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Postgres password — Settings > Database.
# NOT the service-role key: that authenticates against the REST API, not Postgres.
SUPABASE_DB_PASSWORD=your-database-password

# Region of your Supabase project, used to derive the pooler fallback host.
SUPABASE_REGION=ap-south-1

# Optional: set the Supavisor pooler host explicitly, overriding SUPABASE_REGION.
# Find yours in Settings > Database > Connection pooling.
# SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com

# Optional: a full libpq URL, which overrides the two hosts tried above.
# SUPABASE_DB_URL=postgresql://user:pass@host:5432/postgres

# Which embeddings to generate: "local" (default) or "openai".
#   local  — all-MiniLM-L6-v2, 384 dims, offline and free
#   openai — text-embedding-3-small, 1536 dims, needs credit on the key below
EMBEDDING_PROVIDER=local

# Only required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key

# Path to the PDF file to ingest
PDF_PATH=./data/document.pdf
